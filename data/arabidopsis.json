          "viz": "plate"
        },
        {
          "id": "s3",
          "title": "Seedling Growth",
          "desc": "Grow seeds vertically in growth chamber (22\u00b0C, 16hr light) for 7 days",
          "duration": "7 days",
          "viz": "growth"
        },
        {
          "id": "s4",
          "title": "Root Measurement",
