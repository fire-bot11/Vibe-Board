  "data": {
    "pharynx": {
      "anatomy": {
        "desc": "Bi-lobed muscular pump; grinds bacteria ~200\u00d7/min. Contains grinder (pm7) and two isthmus regions.",
        "tags": [
          "muscle",
          "grinder",
          "pump"
        ]
      },
      "genetics": {
        "desc": "pha-4/FOXA specifies pharynx fate. eat-4 fills glutamate vesicles. mec-7 mechanosensory neurons.",
        "tags": [
          "pha-4",
          "eat-4",
          "mec-7",
          "FOXA"
        ]
      },
      "experiment": {
        "desc": "Pumping rate is a standard healthspan assay. Used in HTS drug screens.",
        "tags": [
          "pumping assay",
          "drug screen",
          "RNAi"
        ]
      }
    },
    "nerve": {
      "anatomy": {
        "desc": "302-neuron neuropil encircling the pharynx. Fully mapped connectome (White 1986; revised 2019).",
        "tags": [
          "connectome",
          "302 neurons",
          "neuropil"
        ]
      },
      "genetics": {
        "desc": "unc-86/Brn3, ceh-10/Chx10 specify identities. ACh, GABA, glutamate, dopamine, 5-HT.",
        "tags": [
          "unc-86",
          "ceh-10",
          "GABA",
          "dopamine"
        ]
      },
      "experiment": {
        "desc": "ChR2/Arch optogenetics. GCaMP calcium imaging in freely moving worms.",
        "tags": [
          "optogenetics",
          "GCaMP",
          "ablation"
        ]
      }
    },
    "gonad": {
      "anatomy": {
        "desc": "Two U-shaped arms. DTC caps mitotic stem cells; oocytes arrested in meiosis I.",
        "tags": [
          "DTC",
          "stem cell",
          "meiosis",
          "germline"
        ]
      },
      "genetics": {
        "desc": "glp-1/Notch maintains stem pool. fog-2, tra-1/tra-2 sex determination.",
        "tags": [
          "glp-1",
          "Notch",
          "fog-2",
          "tra-1"
        ]
      },
      "experiment": {
        "desc": "Primary transgenesis: gonadal microinjection. CRISPR HDR >5% efficiency.",
        "tags": [
          "microinjection",
          "CRISPR",
          "RNAi feeding"
        ]
      }
    },
    "vulva": {
      "anatomy": {
        "desc": "22-cell structure from P5.p, P6.p, P7.p VPCs. EGF/RAS/MAPK induction at L3.",
        "tags": [
          "P6.p",
          "22 cells",
          "L3 larva"
        ]
      },
      "genetics": {
        "desc": "let-60/RAS, mpk-1/MAPK, lin-3/EGF cascade. lin-12/Notch lateral inhibition.",
        "tags": [
          "let-60",
          "lin-3",
          "lin-12",
          "MAPK"
        ]
      },
      "experiment": {
        "desc": "Muv and Vul phenotypes are primary readouts for pathway screens.",
        "tags": [
          "Muv",
          "Vul",
          "cell fate",
          "live imaging"
        ]
      }
    },
    "intestine": {
      "anatomy": {
        "desc": "20 cells in bilateral int rings. Single-cell-thick tube; brush border microvilli. Digestion, lipid/glycogen storage, vitellogenin synthesis, innate immunity.",
        "tags": [
          "20 cells",
          "lipid store",
          "immunity",
          "ploidy"
        ]
      },
      "genetics": {
        "desc": "elt-2/GATA drives intestinal fate. daf-16/FOXO longevity. lgg-1 autophagosomes.",
        "tags": [
          "elt-2",
          "daf-16",
          "FOXO",
          "lgg-1"
        ]
      },
      "experiment": {
        "desc": "Fat by BODIPY/Sudan Black. RNAi spreads systemically from here. LysoSensor for lysosomes.",
        "tags": [
          "Sudan Black",
          "BODIPY",
          "RNAi",
          "longevity"
        ]
      }
    }
  },
