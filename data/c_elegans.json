  "lifecycle": [
    {
      "id": "emb",
      "name": "Embryonic",
      "desc": "Cell divisions create 302 neurons. 380 minutes of development. Pharynx and basic organs form.",
      "duration": "0-6 hrs",
      "tags": [
        "Cell division",
        "Neurogenesis"
      ],
      "color": "#7F77DD"
    },
    {
      "id": "l1",
      "name": "Larval Stage 1 (L1)",
      "desc": "Growth by cell division. First feeding begins. Intestinal system becomes active with ~35 cells.",
      "duration": "12 hrs",
      "tags": [
        "Growth",
        "Feeding"
      ],
      "color": "#378ADD"
    },
    {
      "id": "l2",
      "name": "Larval Stage 2 (L2)",
      "desc": "Continued growth. Gonad begins development. Nerve ring connections established.",
      "duration": "24 hrs",
      "tags": [
        "Development"
      ],
      "color": "#1D9E75"
    },
    {
      "id": "l3",
      "name": "Larval Stage 3 (L3)",
      "desc": "Sexual organs develop. Vulva forms (6 cells). ~1000 oocytes begin meiosis.",
      "duration": "36 hrs",
      "tags": [
        "Sexual differentiation"
      ],
      "color": "#BA7517"
    },
    {
      "id": "adult",
      "name": "Adult Stage",
      "desc": "Sexual maturity reached. Self-fertilization begins. ~300 progeny per animal. Peak egg production.",
      "duration": "2-4 days",
      "tags": [
        "Reproduction"
      ],
      "color": "#D85A30"
    },
    {
      "id": "senesce",
      "name": "Senescence",
      "desc": "Reproduction declines. Lipids accumulate. Aging begins. Lifespan ~20 days.",
      "duration": "4+ days",
      "tags": [
        "Aging"
      ],
      "color": "#8B4513"
    }
  ],
  "workflows": [
    {
      "id": "imaging",
      "name": "Live Imaging Experiment",
      "desc": "Prepare worms for fluorescent microscopy",
      "color": "#378ADD",
      "steps": [
        {
          "id": "s1",
          "title": "Culture Prep",
          "desc": "Grow L4 larvae on NGM plates at 20\u00b0C for 24 hrs",
          "duration": "24 hrs",
          "viz": "culture"
        },
        {
          "id": "s2",
          "title": "Mount Specimen",
          "desc": "Transfer worm to agarose pad with anesthetic (0.1% tricaine)",
          "duration": "5 min",
          "viz": "mount"
        },
        {
          "id": "s3",
          "title": "Confocal Microscopy",
          "desc": "Capture GFP/RFP signals with 63x oil objective, 488nm + 561nm lasers",
          "duration": "30 min",
          "viz": "scope"
        },
        {
          "id": "s4",
          "title": "Image Analysis",
          "desc": "Quantify fluorescence intensity and distribution with ImageJ",
          "duration": "2 hrs",
          "viz": "analysis"
        }
      ]
    },
    {
      "id": "mutagenesis",
      "name": "Forward Genetics Screen",
      "desc": "Identify genes controlling pharynx development",
      "color": "#D85A30",
      "steps": [
        {
          "id": "s1",
          "title": "EMS Mutagenesis",
          "desc": "Treat P0 males with 0.5M EMS for 4 hours",
          "duration": "5 hrs",
          "viz": "mutagen"
        },
        {
          "id": "s2",
          "title": "F1 Cross",
          "desc": "Cross mutagenized males to wild-type females",
          "duration": "24 hrs",
          "viz": "cross"
        },
        {
          "id": "s3",
          "title": "F2 Screening",
          "desc": "Score F2 progeny for pharynx/feeding defects",
          "duration": "1 week",
          "viz": "screen"
        },
        {
          "id": "s4",
          "title": "Mapping & Sequencing",
          "desc": "Map mutations by 3-point cross and sequence candidate genes",
          "duration": "2-4 weeks",
          "viz": "map"
        }
      ]
    }
  ]
}